# AI Study Buddy settings. Copy to .env; an empty .env runs locally in Mock mode.
# Never put a real secret in this file.

# Anything other than "local" turns on the start-up guards (AD-14).
APP_ENV=local

# Required outside local. Must not be the development key.
SECRET_KEY=

# Defaults to true locally and false elsewhere.
DEBUG=

# Holds db.sqlite3 and backups. Defaults to ./data.
DATA_DIR=

# Your Anthropic key for Real mode. Empty means Mock mode. Never commit it.
ANTHROPIC_API_KEY=

# "mock" forces Mock mode even with a key. Defaults to "anthropic" when a key is set.
AI_PROVIDER=

# Comma-separated. Defaults to localhost,127.0.0.1 locally; required elsewhere.
ALLOWED_HOSTS=

# Comma-separated, with https://. Required outside local.
CSRF_TRUSTED_ORIGINS=

# Comma-separated email addresses. Empty means sign-up is open.
SIGNUP_ALLOWED_EMAILS=
